{
  "name": "@dsh-worker/worker",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Durable coding worker controlled by an external orchestrator, built on DeepSeek Harness",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "bin": {
    "dsh-worker": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/core/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/types/contracts/src/index.d.ts",
      "import": "./dist/contracts.js"
    },
    "./plugin": {
      "types": "./dist/types/server/src/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./http": {
      "types": "./dist/types/server/src/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm test",
    "dev": "tsx packages/cli/src/main.ts serve",
    "start": "node dist/cli.js serve",
    "format:check": "prettier --check \"packages/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/*.ts\""
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
