{
  "name": "@dsh-worker/worker",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Durable coding worker controlled by an external orchestrator, built on DeepSeek Harness",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "bin": {
    "dsh-worker": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/types/contracts/src/index.d.ts",
      "import": "./dist/contracts.js"
    },
    "./plugin": {
      "types": "./dist/types/server/src/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./http": {
      "types": "./dist/types/server/src/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx packages/cli/src/main.ts serve",
    "start": "node dist/cli.js serve",
    "format:check": "prettier --check \"packages/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"scripts/*.ts\" eslint.config.mjs vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test:package": "npm run build && tsx scripts/package-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hooks-claude-code": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hooks-codex": "0.1.5-rc.2",
    "@deepseek-ai/dsh-lsp": "0.1.5-rc.2",
    "@deepseek-ai/dsh-lsp-stdio": "0.1.5-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-terminal": "0.1.5-rc.2",
    "@deepseek-ai/dsh-terminal-bash": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-lsp": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-terminal": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "typescript": "5.9.3",
    "typescript-language-server": "5.0.0",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-fs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.6"
  }
}
